# Copia este archivo como .env y ajusta los valores
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_DB=inventario

# Para correr la API fuera de Docker (uvicorn local) apuntando al Postgres del contenedor:
DATABASE_URL=postgresql+psycopg://inventario:inventario@localhost:5432/inventario

# Déjala vacía en local; en Render pon una larga y secreta
API_KEY=
ENVIRONMENT=local
