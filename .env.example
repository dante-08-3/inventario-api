# Copia este archivo como .env y ajusta los valores
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_DB=inventario

# Para correr la API fuera de Docker (uvicorn local) apuntando al Postgres del contenedor:
DATABASE_URL=postgresql+psycopg://inventario:inventario@localhost:5432/inventario

# Déjala vacía en local; en Render pon una larga y secreta
API_KEY=
ENVIRONMENT=local

# n8n: a qué API se conecta el flujo y con qué llave
# (la de Render por defecto; para la API local usa http://api:8000 y deja la llave vacía)
INVENTARIO_URL=https://inventario-api-qu64.onrender.com
INVENTARIO_API_KEY=PEGA_AQUI_TU_API_KEY
